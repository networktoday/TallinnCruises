# Template di configurazione — copia in `.env` e compila i valori.
# Il file .env reale è escluso da git e non va mai committato.

# --- Sito (Vite: variabili OBBLIGATORIE per dev/build/preview) ---
PORT=5173
BASE_PATH=/

# --- GitHub (push/pull del repository) ---
GITHUB_TOKEN=

# --- Database (PostgreSQL + Drizzle, per il futuro api-server) ---
DATABASE_URL=

# --- Docker stack (container viabaltica-db) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
SESSION_SECRET=

# --- API server (Express) ---
API_PORT=8080

# --- Backoffice ---
SITE_URL=https://privatetourstallinn.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Email: Resend ---
RESEND_API_KEY=
MAIL_FROM=Tallinn Private Tours <booking@privatetourstallinn.com>
NOTIFY_EMAIL=info@viabaltica.eu

# --- Stripe (sandbox/test: sk_test_... / pk_test_...) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
STRIPE_MODE=test
